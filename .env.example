# Copy to .env for local development. Every value here is a placeholder.
ENV=dev
LOG_LEVEL=INFO

# MySQL container
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_APP_PASSWORD=change-me-app
MYSQL_MIGRATOR_PASSWORD=change-me-migrator
DB_HOST_PORT=3307
API_HOST_PORT=8000

# API (DML user) and Alembic (DDL user), see B16
DATABASE_URL=mysql+pymysql://manuflow_app:change-me-app@db:3306/manuflow?charset=utf8mb4
MIGRATION_DATABASE_URL=mysql+pymysql://manuflow_migrator:change-me-migrator@db:3306/manuflow?charset=utf8mb4

# Integration tests run against a separate schema
TEST_DATABASE_URL=mysql+pymysql://manuflow_app:change-me-app@db:3306/manuflow_test?charset=utf8mb4
TEST_MIGRATION_DATABASE_URL=mysql+pymysql://manuflow_migrator:change-me-migrator@db:3306/manuflow_test?charset=utf8mb4

# Required outside ENV=dev: at least 32 bytes, never the built-in dev default.
# JWT_SECRET=
CORS_ORIGINS=["http://localhost:5173"]
